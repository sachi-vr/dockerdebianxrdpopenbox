#!/bin/sh
set -eu

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    kill "${PIPEWIRE_PULSE_PID:-}" "${WIREPLUMBER_PID:-}" "${PIPEWIRE_PID:-}" 2>/dev/null || true
    exit "$status"
}
trap cleanup EXIT HUP INT TERM

pipewire >/tmp/pipewire-$(id -u).log 2>&1 &
PIPEWIRE_PID=$!

wireplumber >/tmp/wireplumber-$(id -u).log 2>&1 &
WIREPLUMBER_PID=$!

pipewire-pulse >/tmp/pipewire-pulse-$(id -u).log 2>&1 &
PIPEWIRE_PULSE_PID=$!

i=0
while [ "$i" -lt 50 ]; do
    if pw-cli quit >/dev/null 2>&1; then
        break
    fi
    i=$((i + 1))
    sleep 0.1
done

if [ -x /usr/libexec/pipewire-module-xrdp/load_pw_modules.sh ]; then
    /usr/libexec/pipewire-module-xrdp/load_pw_modules.sh || true
fi

openbox-session
